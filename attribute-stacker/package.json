{
  "name": "html-attribute-stacker",
  "displayName": "HTML Attribute Stacker",
  "description": "Vertically stacks HTML attributes with proper indentation",
  "version": "1.0.3",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onCommand:html-attribute-stacker.stack"
  ],
  "main": "./main.js",
  "contributes": {
    "commands": [
      {
        "command": "html-attribute-stacker.stack",
        "title": "Stack HTML Attributes"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "html-attribute-stacker.stack",
          "group": "modifier"
        }
      ]
    }
  }
}