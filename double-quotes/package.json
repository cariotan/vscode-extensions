{
    "name": "html-quotes-converter",
    "displayName": "HTML Quotes Converter",
    "description": "Converts HTML attribute double quotes to single quotes",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./extension.js",
    "contributes": {
        "commands": [
            {
                "command": "extension.convertHtmlQuotes",
                "title": "Convert HTML Quotes to Single"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "extension.convertHtmlQuotes",
                    "group": "modify"
                }
            ]
        }
    },
    "scripts": {
        "lint": "eslint .",
        "pretest": "npm run lint",
        "test": "node ./test/runTest.js"
    },
    "devDependencies": {
        "@types/vscode": "^1.85.0",
        "@types/glob": "^8.1.0",
        "@types/mocha": "^10.0.6",
        "@types/node": "18.x",
        "eslint": "^8.56.0",
        "glob": "^10.3.10",
        "mocha": "^10.2.0",
        "typescript": "^5.3.3",
        "@vscode/test-electron": "^2.3.9"
    }
}