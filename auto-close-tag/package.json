{
	"name": "pure-auto-close-tag",
	"displayName": "Pure Auto Close Tag (No Slash)",
	"description": "Closes HTML tags on >, completely ignores /",
	"version": "1.0.3",
	"publisher": "local",
	"engines": {
		"vscode": "^1.70.0"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./extension.js",
	"scripts": {
		"package": "node -e \"const fs=require('fs'),{execSync}=require('child_process'),p=JSON.parse(fs.readFileSync('package.json','utf8')),a=process.argv[1],v=p.version.split('.').map(Number);p.version=!a||a==='patch'?[v[0],v[1],v[2]+1].join('.'):a==='minor'?[v[0],v[1]+1,0].join('.'):a==='major'?[v[0]+1,0,0].join('.'):a.replace(/^v/,'');fs.writeFileSync('package.json',JSON.stringify(p,null,1)+'\\n');console.log('Version -> '+p.version);execSync('vsce package --no-dependencies --allow-missing-repository --skip-license',{stdio:'inherit'})\"",
		"install-local": "node -e \"const fs=require('fs'),{execSync}=require('child_process');execSync('npm run package '+(process.argv[1]||''),{stdio:'inherit'});const p=JSON.parse(fs.readFileSync('package.json','utf8'));execSync('code --install-extension '+p.name+'-'+p.version+'.vsix',{stdio:'inherit'})\""
	},
	"contributes": {
		"configuration": {
			"title": "Pure Auto Close Tag",
			"properties": {
				"pureAutoCloseTag.supportedLanguages": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"html",
						"javascript",
						"typescript",
						"javascriptreact",
						"typescriptreact",
						"vue",
						"svelte",
						"php",
						"xml",
						"astro",
						"aspnetcorerazor",
						"razor"
					],
					"description": "List of language IDs where auto-closing tags should be active. Use '*' to enable for all languages."
				},
				"pureAutoCloseTag.excludedTags": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"area",
						"base",
						"br",
						"col",
						"command",
						"embed",
						"hr",
						"img",
						"input",
						"keygen",
						"link",
						"meta",
						"param",
						"source",
						"track",
						"wbr"
					],
					"description": "List of tags that should not be auto-closed."
				}
			}
		}
	}
}