{
 "name": "custom-quick-open",
 "displayName": "Custom Quick Open",
 "version": "0.0.7",
 "engines": {
  "vscode": "^1.80.0"
 },
 "activationEvents": [],
 "main": "./extension.js",
 "contributes": {
  "commands": [
   {
    "command": "customSearch.start",
    "title": "Custom Search: Files or Symbols"
   }
  ],
  "configuration": {
   "title": "Custom Search",
   "properties": {
    "customSearch.highPriorityExtensions": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "default": [".cshtml", ".cs"],
     "description": "File extensions to sort at the top of file search results (e.g. .cshtml, .cs)."
    },
    "customSearch.lowPriorityExtensions": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "default": [".map", ".log"],
     "description": "File extensions to sort at the bottom of file search results (e.g. .map, .log)."
    }
   }
  }
 }
}