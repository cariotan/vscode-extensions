{
	"name": "collapse-to-tab-js",
	"displayName": "Collapse To Tab (JS)",
	"description": "When 4 spaces or 4 tabs occur in a row, collapse them into a single tab",
	"version": "0.0.2",
	"publisher": "your-name",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Other"
	],
	"main": "./extension.js",
	"activationEvents": [
		"onStartupFinished",
		"onCommand:collapse-to-tab.fixDocument"
	],
	"scripts": {
		"package": "node -e \"const fs=require('fs'),{execSync}=require('child_process'),p=JSON.parse(fs.readFileSync('package.json','utf8')),a=process.argv[1],v=p.version.split('.').map(Number);p.version=!a||a==='patch'?[v[0],v[1],v[2]+1].join('.'):a==='minor'?[v[0],v[1]+1,0].join('.'):a==='major'?[v[0]+1,0,0].join('.'):a.replace(/^v/,'');fs.writeFileSync('package.json',JSON.stringify(p,null,1)+'\\n');console.log('Version -> '+p.version);execSync('vsce package --no-dependencies --allow-missing-repository --skip-license',{stdio:'inherit'})\"",
		"install-local": "node -e \"const fs=require('fs'),{execSync}=require('child_process');execSync('npm run package '+(process.argv[1]||''),{stdio:'inherit'});const p=JSON.parse(fs.readFileSync('package.json','utf8'));execSync('code --install-extension '+p.name+'-'+p.version+'.vsix',{stdio:'inherit'})\""
	},
	"contributes": {
		"commands": [
			{
				"command": "collapse-to-tab.fixDocument",
				"title": "Collapse To Tab"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "collapse-to-tab.fixDocument",
					"when": "editorTextFocus",
					"group": "modify"
				}
			]
		}
	}
}